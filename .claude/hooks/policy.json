{
  "_doc": "Política de frenos (PreToolUse) para Claude Code. Ver guard.py para los tipos de regla. 'tests' son casos que comprueba test_guard.py.",
  "rules": [
    {
      "type": "pattern",
      "tool": "Bash|WebFetch",
      "input": "(api\\.openai\\.com/v1/images|/v1/images/(generations|edits|variations)|gpt-image-\\d|dall-?e-?\\d)",
      "decision": "deny",
      "reason": "Regla permanente de MILLA Video Studio: nunca ChatGPT Image ni otras imágenes de OpenAI, tampoco como respaldo. Usar Kie nano-banana-2-lite."
    },
    {
      "type": "pattern",
      "tool": "mcp__.*([Oo]pen[Aa][Ii]|[Cc]hat[Gg][Pp][Tt]|[Dd][Aa][Ll][Ll]).*",
      "decision": "deny",
      "reason": "Regla permanente: nunca imágenes de ChatGPT/OpenAI."
    },
    {
      "type": "pattern",
      "tool": "Bash",
      "field": "command",
      "input": "git\\s+(-C\\s+\\S+\\s+)?push\\b[^\\n;&|]*(\\s--force\\b|\\s--force-with-lease\\b|\\s-f\\b|\\s\\+\\S)",
      "decision": "deny",
      "reason": "No se permite `git push --force`: puede borrar historial ajeno."
    },
    {
      "type": "pattern",
      "tool": "Bash",
      "field": "command",
      "input": "(^|[;&|(]\\s*|\\s)git\\s+(-[Cc]\\s+\\S+\\s+)*push\\b",
      "decision": "ask",
      "reason": "Vas a publicar en GitHub. Confirma que la tarea actual autoriza este push."
    },
    {
      "type": "before_git",
      "git": "commit",
      "staged_regex": "^skills/",
      "run": "python3 -m unittest discover -s skills/milla-video-studio/scripts -p 'test_*.py'",
      "reason": "Las pruebas de la skill no pasan."
    },
    {
      "type": "before_git",
      "git": "push",
      "run": "python3 skills/milla-video-studio/scripts/milla.py secret-scan .",
      "reason": "El escaneo de secretos encontró hallazgos."
    },
    {
      "type": "secrets",
      "git": "commit",
      "pii": true,
      "reason": "El cambio contiene posibles secretos o datos personales."
    },
    {
      "type": "before_git",
      "git": "commit",
      "staged_regex": "(^|/)SKILL\\.md$",
      "run": "python3 .claude/hooks/check_skill.py skills/milla-video-studio",
      "reason": "El SKILL.md dejaría de ser compatible con claude.ai."
    },
    {
      "type": "before_git",
      "git": "commit",
      "staged_regex": "^\\.claude/hooks/",
      "run": "python3 .claude/hooks/test_guard.py",
      "reason": "Las pruebas de los frenos fallaron."
    }
  ],
  "tests": [
    {
      "name": "push forzado",
      "tool": "Bash",
      "input": {
        "command": "git push --force origin main"
      },
      "expect": "deny"
    },
    {
      "name": "comando inocuo",
      "tool": "Bash",
      "input": {
        "command": "ls -la"
      },
      "expect": "none"
    },
    {
      "name": "imagen OpenAI",
      "tool": "Bash",
      "input": {
        "command": "curl https://api.openai.com/v1/images/generations -d '{}'"
      },
      "expect": "deny"
    },
    {
      "name": "conector ChatGPT",
      "tool": "mcp__ChatGPT__generate_image",
      "input": {
        "prompt": "x"
      },
      "expect": "deny"
    }
  ]
}
