{
  "name": "milla-video-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plantilla nueva y determinista; no es el código recuperado ni un render aprobado.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "render": "remotion render src/index.ts MillaVideo out/review.mp4 --codec=h264 --audio-codec=aac --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/media": "4.0.532",
    "remotion": "4.0.532",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3"
  },
  "engines": {"node": ">=22"}
}
